# Vite auto-loads this in test mode (vitest defaults to MODE=test). A
# syntactically valid but fake project -- supabase-js validates the URL at
# client-construction time but makes no network call, and every test stubs
# the specific client methods it exercises, so this is never actually used
# to reach a real backend.
VITE_SUPABASE_URL=https://test-project.supabase.co
VITE_SUPABASE_ANON_KEY=test-anon-key-not-real
