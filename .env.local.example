# Copy this file to .env.local and fill in values from your Supabase project:
# Project Settings -> API -> Project URL / anon public key.
# .env.local is gitignored — never commit real keys.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Web Push VAPID public key (safe to expose client-side — it's the public
# half of the keypair). Generate a pair with: npx web-push generate-vapid-keys
# The PRIVATE key is a secret and never goes here — it lives only in the
# Supabase Edge Function's secrets.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
